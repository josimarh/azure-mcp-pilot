include LICENSE
include README.md
recursive-include services/data *.json

# O pacote publicado expõe apenas o servidor MCP. Os arquivos de teste e
# scripts de release existem no repositório para desenvolvimento e CI,
# e não fazem parte da superfície distribuída.
exclude test_smoke.py
exclude test_tool_annotations.py
exclude test_tool_catalog_smoke.py
exclude test_capability_layer.py
exclude requirements.txt
exclude .env.example
prune .agents
prune assets
prune .vscode
