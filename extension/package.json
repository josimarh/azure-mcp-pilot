{
  "name": "idengraph",
  "displayName": "IdenGraph",
  "description": "Identity & Access intelligence powered by Microsoft Graph and MCP. Read-only auditing for Microsoft Entra ID and Azure RBAC in Copilot Chat.",
  "version": "0.1.4",
  "publisher": "josimarh",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0B1F3A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Azure",
    "Other"
  ],
  "keywords": [
    "mcp",
    "azure",
    "entra",
    "identity",
    "rbac",
    "security",
    "audit",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josimarh/idengraph.git"
  },
  "bugs": {
    "url": "https://github.com/josimarh/idengraph/issues"
  },
  "homepage": "https://github.com/josimarh/idengraph#readme",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:idengraph.showStatus"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "idengraph.showStatus",
        "title": "IdenGraph: Show readiness status"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "idengraph.provider",
        "label": "IdenGraph"
      }
    ],
    "configuration": {
      "title": "IdenGraph",
      "properties": {
        "idengraph.useMockData": {
          "type": "boolean",
          "default": false,
          "description": "Query fictional data instead of your real tenant. Useful for demos."
        },
        "idengraph.sanitizeOutput": {
          "type": "boolean",
          "default": true,
          "description": "Mask resource names, resource groups, subscription IDs and IP addresses before content reaches the model."
        },
        "idengraph.subscriptions": {
          "type": "string",
          "default": "",
          "description": "Restrict queries to specific subscriptions (comma-separated IDs). Empty queries all accessible subscriptions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.6.0"
  }
}
