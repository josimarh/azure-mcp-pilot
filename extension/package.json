{
  "name": "idengraph",
  "displayName": "IdenGraph",
  "description": "Identity & Access intelligence powered by Microsoft Graph and MCP. Auditoria read-only de Microsoft Entra ID e Azure RBAC no Copilot Chat.",
  "version": "0.1.0",
  "publisher": "josimarh",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0B1F3A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Azure",
    "Other"
  ],
  "keywords": [
    "mcp",
    "azure",
    "entra",
    "identity",
    "rbac",
    "security",
    "audit",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josimarh/azure-mcp-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/josimarh/azure-mcp-pilot/issues"
  },
  "homepage": "https://github.com/josimarh/azure-mcp-pilot#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "idengraph.provider",
        "label": "IdenGraph"
      }
    ],
    "configuration": {
      "title": "IdenGraph",
      "properties": {
        "idengraph.useMockData": {
          "type": "boolean",
          "default": false,
          "description": "Usa dados fictícios em vez de consultar o tenant real. Útil para demonstração."
        },
        "idengraph.sanitizeOutput": {
          "type": "boolean",
          "default": true,
          "description": "Mascara nomes de recursos, resource groups, IDs de subscription e IPs antes que o conteúdo chegue ao modelo."
        },
        "idengraph.subscriptions": {
          "type": "string",
          "default": "",
          "description": "Limita as consultas a subscriptions específicas (IDs separados por vírgula). Vazio consulta todas as subscriptions acessíveis."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.6.0"
  }
}
