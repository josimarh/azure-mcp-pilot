# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELS=liquid/lfm-2.5-2.6b:free,openrouter/free
OPENROUTER_APP_TITLE=Azure Environment Copilot Pilot
OPENROUTER_HTTP_REFERER=http://localhost:8501

# Start in mock mode. Set false only in an approved Azure test/dev environment.
MOCK_MODE=true

# Optional: restrict Azure Resource Graph to specific subscriptions.
# Leave empty to query the accessible tenant scope (when MOCK_MODE=false).
AZURE_SUBSCRIPTIONS=

# Safety: masks resource names, resource groups, subscription IDs and IPs before LLM use.
SANITIZE_FOR_LLM=true
